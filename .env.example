# .env.example — ก๊อปเป็น .env แล้วเติมค่าจริง (สำหรับ netlify dev / vite dev)
# กฎเหล็ก: ห้ามตั้งชื่อ secret ขึ้นต้นด้วย VITE_ (Vite ฝัง VITE_* ลง bundle = รั่ว), .env จริงห้าม commit

# ── client (ฝังใน bundle ได้ ปลอดภัยเมื่อเปิด RLS) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── function เท่านั้น (ห้ามหลุดไป client) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-key

# ── PromptPay (Wave 2 ระบบเก็บเงิน) ──
# เบอร์มือถือ 10 หลัก หรือเลขบัตร ปชช. 13 หลักที่ผูกพร้อมเพย์ไว้ — ใช้สร้าง QR ฝั่ง client
# (payload EMVCo มาตรฐาน ไม่ใช้ API เสียเงิน) พร้อมยอด 39 บาทติดมาในโค้ด QR เลย
# ไม่ใช่ VITE_ เพราะไม่ควรฝังลง bundle — function ส่งค่านี้ให้หน้า Premium ผ่าน create-payment
PROMPTPAY_ID=0812345678
